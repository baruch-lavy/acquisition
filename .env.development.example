# Copy this file to .env.development and fill in real values.
# .env.development is git-ignored and should never be committed.

# ─── Application ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# ─── Neon Local proxy (neondatabase/neon_local container) ───────────────────────
# Get these from https://console.neon.tech → Project Settings → General
NEON_API_KEY=
NEON_PROJECT_ID=

# Optional: ID of the branch to fork from when creating ephemeral branches.
# Leave blank to default to your project's primary branch.
PARENT_BRANCH_ID=

# ─── Database — app connects to the Neon Local proxy inside the Compose network ─
DATABASE_URL=postgres://neon:npg@neon-local:5432/neondb?sslmode=require

# ─── Neon Local flags (read by src/config/database.js) ──────────────────────────
NEON_LOCAL=true
NEON_LOCAL_HOST=neon-local
NEON_LOCAL_PORT=5432

# ─── Arcjet ──────────────────────────────────────────────────────────────────────
ARCJET_KEY=
