# Copy this file to .env.production and fill in real values.
# .env.production is git-ignored and should never be committed.
# In a CI/CD pipeline inject these as secrets instead of a file.

# ─── Application ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# ─── Database — Neon Cloud (no local proxy in production) ───────────────────────
# Paste your pooled Neon connection string from the Neon console.
# Dashboard → Connection Details → Connection string (pooled)
DATABASE_URL=postgres://<user>:<password>@<endpoint>-pooler.neon.tech/<dbname>?sslmode=require

# ─── Neon Local disabled ─────────────────────────────────────────────────────────
NEON_LOCAL=false

# ─── Arcjet ──────────────────────────────────────────────────────────────────────
ARCJET_KEY=
